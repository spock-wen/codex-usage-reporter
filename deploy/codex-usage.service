[Unit]
Description=Private Codex usage reporting service
After=network.target

[Service]
Type=simple
User=codex-usage
Group=codex-usage
WorkingDirectory=/opt/codex-usage/current
ExecStart=/usr/bin/python3 /opt/codex-usage/current/server.py --host 127.0.0.1 --port 18765 --config /etc/codex-usage/server.json --db /var/lib/codex-usage/usage.sqlite3 --prices /opt/codex-usage/current/prices.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/codex-usage

[Install]
WantedBy=multi-user.target
